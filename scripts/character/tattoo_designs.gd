## The mask as rows of booleans: [y][x] -> ink.
static func mask(design: StringName) -> Array:
	var rows: Array = MASKS.get(design, MASKS[&"koi"])
	var result := []
	for row: String in rows:
		var line := []
		for ch in row:
			line.append(ch == "#")
		result.append(line)
	return result
